    {
      "match": "FranklinGothic",
      "family": "Oswald",
      "weight": "bold",
      "style": "normal",
      "note": "Heavy condensed sans — Oswald is the closest free analogue to ITC Franklin Gothic Demi/Bold."
    },
    {
      "match": "HelveticaNeue",
      "family": "Inter",
      "weight": "normal",
      "style": "normal",
      "note": "Inter was explicitly designed as a Helvetica-class neutral grotesque."
    },
    {
      "match": "Helvetica",
      "family": "Inter",
      "weight": "normal",
      "style": "normal"
    },
    {
