# Production template. Every variable the code reads is here; a value shown on
# a commented line is the default. `php artisan app:check-config` lists what is
# still missing or unsafe, and production refuses to boot until it passes.
#
# Local development overrides in .env: APP_ENV=local, APP_DEBUG=true,
# APP_URL=http://localhost:8081, SESSION_SECURE_COOKIE=false, REDIS_HOST=redis,
# LOG_STACK=single, LOG_LEVEL=debug, MAIL_MAILER=log. Without Redis also set
# SESSION_DRIVER=file, CACHE_STORE=file, QUEUE_CONNECTION=sync.

# --- Application -------------------------------------------------------------
APP_NAME=Netkit
APP_ENV=production
APP_KEY=
# Comma separated old keys, kept while rotating APP_KEY so existing cookies decrypt.
# APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL=https://netkit.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Sail / artisan serve only.
# APP_PORT=80
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Set to false only to boot a broken deployment for diagnosis.
# PRODUCTION_CONFIG_CHECK=true
# Config keys of required secrets this deployment runs without, comma separated
# (see config/production.php), e.g. services.recraft.key,services.fal.key
# PRODUCTION_CONFIG_OPTIONAL=

# --- Logging -----------------------------------------------------------------
LOG_CHANNEL=stack
# daily rotates files and keeps LOG_DAILY_DAYS of them; use stderr in containers
# whose platform collects stdout/stderr.
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null
# LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
# LOG_SLACK_WEBHOOK_URL=

# --- Database ----------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=netkit
DB_USERNAME=netkit
DB_PASSWORD=
# Path to the CA bundle when the server requires TLS (Azure MySQL Flexible Server does).
# MYSQL_ATTR_SSL_CA=

# --- Redis: sessions, cache, rate limiter, queues, Horizon --------------------
# One instance, one database index per concern (config/database.php):
#   0 queues + Horizon + cache locks   1 cache   2 sessions   3 rate limiter
# On that shared instance set maxmemory-policy to noeviction or volatile-lru so
# queued jobs are never evicted. To move a concern to its own instance set
# REDIS_<CACHE|SESSION|LIMITER>_HOST (also _PORT, _PASSWORD, _USERNAME, _URL).
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
# REDIS_USERNAME=
# rediss://... for TLS (Azure Cache for Redis listens on 6380 with TLS only).
# REDIS_URL=
# REDIS_DB=0
# REDIS_CACHE_DB=1
# REDIS_SESSION_DB=2
# REDIS_LIMITER_DB=3
# REDIS_PREFIX=netkit-database-
# REDIS_PERSISTENT=false

SESSION_DRIVER=redis
# SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# SESSION_COOKIE=netkit-session
# SESSION_HTTP_ONLY=true
# SESSION_EXPIRE_ON_CLOSE=false

CACHE_STORE=redis
# CACHE_PREFIX=netkit-cache-
# Store for login and route throttles. Defaults to the dedicated "limiter"
# Redis store when CACHE_STORE=redis, otherwise to the default store.
# CACHE_LIMITER_STORE=limiter

QUEUE_CONNECTION=redis
# Must stay above the longest job timeout (document conversion, 900 s).
REDIS_QUEUE_RETRY_AFTER=960
# REDIS_QUEUE=default
# QUEUE_FAILED_DRIVER=database-uuids

BROADCAST_CONNECTION=log

# --- Horizon -----------------------------------------------------------------
# Dashboard at /horizon (admins only, app/Providers/HorizonServiceProvider.php).
# HORIZON_PATH=horizon
# HORIZON_DOMAIN=
# HORIZON_NAME=
# HORIZON_PREFIX=netkit_horizon:
# HORIZON_REDIS_CONNECTION=default
# ops:horizon-watchdog mails this address when it has to restart Horizon.
HORIZON_ALERT_EMAIL=

# --- Files ---------------------------------------------------------------------
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# AWS_URL=
# AWS_ENDPOINT=

# --- Mail ----------------------------------------------------------------------
# Verification, password reset and sign-in codes are e-mailed: "log" is refused
# in production. With resend, set RESEND_API_KEY and a verified sender.
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="hello@netkit.example"
MAIL_FROM_NAME="${APP_NAME}"
# SMTP instead of Resend:
# MAIL_SCHEME=null
# MAIL_HOST=127.0.0.1
# MAIL_PORT=2525
# MAIL_USERNAME=null
# MAIL_PASSWORD=null

# SMS sign-in codes. Not wired up yet: app/Services/SmsService.php only writes
# the message to the log, whatever these are set to.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# --- Sign-in -------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL="${APP_URL}/auth/google/callback"

# Cloudflare Turnstile on the login, register and password-reset forms
# (config/security.php). Unset = the honeypot field alone.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Response security headers (config/security.php). CSP starts in report-only
# mode; set SECURITY_CSP_MODE=enforce once violation reports are clean.
SECURITY_HSTS=true
# SECURITY_HSTS_MAX_AGE=31536000
# SECURITY_HSTS_SUBDOMAINS=true
# SECURITY_HSTS_PRELOAD=false
SECURITY_CSP_MODE=report-only
SECURITY_CSP_REPORT_URI=
# SECURITY_CSP_POLICY=
# SECURITY_FRAME_OPTIONS=SAMEORIGIN
# SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
# SECURITY_PERMISSIONS_POLICY=
# SECURITY_COOP=same-origin-allow-popups

# --- Billing -------------------------------------------------------------------
# Live keys. STRIPE_WEBHOOK_SECRET is the signing secret of the production
# webhook endpoint; without it credit top-ups cannot be verified.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Recurring Stripe price (price_...) for the $5.99/month all-access plan. Until it
# is set, the portal shows the plan but refuses checkout.
STRIPE_ALL_ACCESS_MONTH_PRICE_ID=

# --- Domain search ---------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Availability lookups: namecheap or whois.
DOMAIN_LOOKUP=namecheap
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
# NAMECHEAP_USERNAME defaults to NAMECHEAP_API_USER.
NAMECHEAP_USERNAME=
# The server's public egress IP, which must be allow-listed at Namecheap.
NAMECHEAP_CLIENT_IP=
# The code defaults to the sandbox; production must say false.
NAMECHEAP_SANDBOX=false
GODADDY_API_KEY=
GODADDY_API_SECRET=
# GODADDY_BASE_URL=https://api.godaddy.com

# --- Logo generation -------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_BASE_URL=https://api.openai.com/v1
FAL_AI_KEY=
RECRAFT_KEY=
# RECRAFT_BASE_URL=https://external.api.recraft.ai
LOGO_EDITOR_ENABLED=false
LOGO_CUSTOM_PROMPT_ENABLED=false
# Home page hero animation; the options are listed in config/home.php.
# HOME_HERO_BACKGROUND=fill_logo

# --- PDF editor ------------------------------------------------------------------
# The editor is developed and tested with these three values; the code's own
# defaults (fitz_extraction, default, full_page_save) are older modes.
PDF_MODE=annotation_base
LAYOUT_MODE=new_writer
PDF_SAVE_MODE=live_save
SPLIT_PARAGRAPH_FULLY=false
LINE_GROUPING_EDITOR_MODE=false
EDITOR_DEBUG=false

# Documents of visitors without an account (config/pdf_editor.php 'guests'):
# owned through a token in an encrypted cookie, kept this many days after the
# visitor was last seen, then removed with their files by documents:prune-guests.
# PDF_GUEST_DOCUMENT_LIFETIME_DAYS=7
# Whether the scheduler removes them (daily). On in production, off elsewhere
# unless set: a development database is full of ownerless QA documents.
# PDF_GUEST_PRUNE=true
# A guest can open at most this many of their most recent documents.
# PDF_GUEST_MAX_DOCUMENTS=50

# Uploads (config/pdf_editor.php 'uploads'). A PDF is checked before anything is
# stored or queued: readable, no open password, at most MAX_PAGES pages.
# PDF_UPLOAD_MAX_KB=20480
# PDF_UPLOAD_MAX_PAGES=500
# Seconds the check may take before the PDF is refused as too complex.
# PYTHON_TIMEOUT_PROBE=10
# Documents an account without the PDF editor plan may create per month.
# PDF_UPLOAD_MONTHLY_LIMIT=100
# Documents a visitor without an account may create per day: per session and
# address, and per address alone. Both default to thousands when APP_ENV=local.
# PDF_UPLOAD_GUEST_DAILY_LIMIT=5
# PDF_UPLOAD_GUEST_DAILY_LIMIT_PER_IP=20

# Rate limits for the editor's routes (config/editor_limits.php): every route
# that forks Python or writes state has a class there (uploads 5/min and 50/day,
# exports 5/min, processing 10/min, ...). SCALE multiplies every limit; it
# defaults to 20 when APP_ENV=local so the QA suites can run, and to 1 otherwise.
# EDITOR_RATE_LIMIT_SCALE=1
# A guest is limited per session and address, and per address alone at this
# multiple (several people behind one address; scripts that drop cookies).
# EDITOR_RATE_LIMIT_GUEST_IP_FACTOR=4

# Upload processing (config/pdf_editor.php 'extraction'): text extraction of a
# new PDF runs as ProcessUploadedDocumentJob on its own Horizon queue, and the
# editor waits on documents.processing_status.
# PDF_EXTRACTION_QUEUE_CONNECTION=redis
# PDF_EXTRACTION_QUEUE=pdf-extraction
# Whole-job budget; keep it above PYTHON_TIMEOUT_EXTRACT and below REDIS_QUEUE_RETRY_AFTER.
# PDF_EXTRACTION_JOB_TIMEOUT=300
# A document still queued after this long is reported to the editor as failed, with a retry.
# PDF_EXTRACTION_STALE_QUEUED_SECONDS=600

# Autosave limits (config/pdf_editor.php). A refused save answers 413 or 422
# with a message the editor shows; 429 makes it wait and send again. Keep the
# web server's body limit (nginx client_max_body_size) at or above MAX_BODY_KB.
# PDF_AUTOSAVE_MAX_BODY_KB=20480
# PDF_AUTOSAVE_MAX_ANNOTATIONS=3000
# Characters of text in one annotation; rich-text HTML gets four times this.
# PDF_AUTOSAVE_MAX_TEXT_LENGTH=50000
# Per editor (account or guest session) and document; the editor saves at most
# every 1.8 s, about 33 a minute.
# PDF_AUTOSAVE_SAVES_PER_MINUTE=60
# Per address, for clients that drop their cookies to dodge the limit above.
# PDF_AUTOSAVE_SAVES_PER_MINUTE_PER_IP=600

# Python subprocesses (config/python.php): every call goes through
# App\Services\PythonRunner with a hard timeout and a per-server concurrency
# cap; a request that cannot get a slot in time is answered 503 + Retry-After.
# Interpreter tried first; the project virtualenvs and /usr/bin/python3 follow.
# PYTHON_BINARY=
# Slots are locks in a cache store (PYTHON_LOCK_STORE, default: the default
# store). On a Redis shared by every container the cap is therefore global,
# across all web and worker containers, not per container: size it to the
# total cores available for PDF work. Each process can use a full core.
# PYTHON_MAX_CONCURRENT=4
# PYTHON_SLOT_WAIT_SECONDS=8
# PYTHON_LOCK_STORE=
# PYTHON_TIMEOUT_SECONDS=120
# PYTHON_TIMEOUT_EXPORT=180
# PYTHON_TIMEOUT_EXTRACT=120
# Kill a process that prints nothing for this long (0 = off).
# PYTHON_IDLE_TIMEOUT_SECONDS=0
# Address-space cap per process in MB via ulimit -v (0 = off; torch and OpenCV
# reserve large virtual ranges, so test before setting it).
# PYTHON_MEMORY_LIMIT_MB=0

# Editor Download (config/pdf_export.php): exports run as ExportAnnotatedPdfJob
# on their own Horizon queue and the editor polls for the result. The
# in-request path exists for the QA suites and replay tools and is off in
# production unless PDF_EXPORT_ALLOW_SYNC=true.
# PDF_EXPORT_ALLOW_SYNC=false
# PDF_EXPORT_QUEUE_CONNECTION=redis
# PDF_EXPORT_QUEUE=pdf-export
# Whole-job budget; keep it above PYTHON_TIMEOUT_EXPORT and below REDIS_QUEUE_RETRY_AFTER.
# PDF_EXPORT_JOB_TIMEOUT=240
# How long a finished export and its signed link stay downloadable.
# PDF_EXPORT_RESULT_TTL_MINUTES=15
# Exports no worker picked up are failed by documents:cleanup-temp after this long.
# PDF_EXPORT_STALE_AFTER_MINUTES=30

# Merge limits (config/pdf_editor.php).
# PDF_MERGE_MAX_FILES=10
# PDF_MERGE_MAX_FILE_KB=20480
# PDF_MERGE_MAX_TOTAL_BYTES=104857600
# PDF_MERGE_MAX_PAGES=1000
# PDF_MERGE_MAX_FILE_PAGES=100
# PDF_MERGE_TIMEOUT_SECONDS=120

# Word / Excel conversion runs on Adobe PDF Services.
ADOBE_PDF_SERVICES_CLIENT_ID=
ADOBE_PDF_SERVICES_CLIENT_SECRET=
ADOBE_PDF_SERVICES_REGION=US
# ADOBE_PDF_SERVICES_BASE_URL=https://pdf-services.adobe.io
# ADOBE_PDF_SERVICES_TOKEN_URL=https://ims-na1.adobelogin.com/ims/token/v3
# ADOBE_PDF_SERVICES_SCOPES=openid,AdobeID,DCAPI
# ADOBE_PDF_SERVICES_REQUEST_TIMEOUT=120
# ADOBE_PDF_SERVICES_POLL_TIMEOUT=180
# ADOBE_PDF_SERVICES_POLL_INTERVAL_MS=1000
DOCUMENT_CONVERSION_PRICE_USD=0.10
DOCUMENT_CONVERSION_PAGES_PER_TRANSACTION=50

# --- QA tooling (leave unset in production) --------------------------------------
# Lets the Playwright suites sign in through the real Filament login so
# admin-gated editor controls can be exercised. Unset = those checks are skipped.
AUTOMATED_TESTS_ADMIN_EMAIL=
AUTOMATED_TESTS_ADMIN_PASSWORD=
# Extra artifact directories for the regression runner.
# PDF_TEST_OUTPUT_DIR=
# PDF_TEST_FALLBACK_OUTPUT_DIR=

VITE_APP_NAME="${APP_NAME}"
